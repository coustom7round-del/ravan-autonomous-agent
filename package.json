{
  "name": "ravan-autonomous-agent",
  "version": "1.0.0",
  "description": "Ravan: Autonomous Agent Orchestration with Self-Learning and Persistent Evolution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ravan": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "gateway": "node dist/gateway/run.js",
    "cli": "node dist/cli/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "self-learning",
    "autonomous",
    "evolution",
    "gateway"
  ],
  "author": "Ravan Contributors",
  "license": "MIT",
  "dependencies": {
    "anthropic": "^0.87.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fastify": "^4.25.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "redis": "^4.6.13",
    "sqlite": "^5.0.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "ws": "^8.15.0",
    "zod": "^3.22.4",
    "node-telegram-bot-api": "^0.63.0",
    "discord.js": "^14.14.0",
    "@slack/bolt": "^3.16.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
